From d5513978aa01dcb4487fe380917f3ba980d7f555 Mon Sep 17 00:00:00 2001
From: Murad Jabir <dev@muradjabir.com>
Date: Sat, 14 Nov 2026 08:48:30 +0530
Subject: [PATCH] util/detect_arch: treat __arm64ec__ as AArch64, not x86_64

MinGW/Clang targeting ARM64EC (e.g. arm64ec-w64-mingw32-clang) defines
__x86_64__ and __amd64__ alongside __arm64ec__, but does not define
MSVC's _M_ARM64EC unless Windows headers or MSVC-compat flags are used.
As a result, DETECT_ARCH_X86_64 gets enabled instead of
DETECT_ARCH_AARCH64, causing x86 SIMD headers (<mmintrin.h>,
<xmmintrin.h>) to be included and breaking builds on ARM64EC MinGW.

Exclude __arm64ec__ from DETECT_ARCH_X86_64 (in addition to _M_ARM64EC,
and applied uniformly across __x86_64__, _M_X64, _M_AMD64, and __x86_64)
and include __arm64ec__ in DETECT_ARCH_AARCH64.

Signed-off-by: Murad Jabir <dev@muradjabir.com>
---
 src/util/detect_arch.h | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/src/util/detect_arch.h b/src/util/detect_arch.h
index e32de8d..410807b 100644
--- a/src/util/detect_arch.h
+++ b/src/util/detect_arch.h
@@ -58,9 +58,10 @@
 #define DETECT_ARCH_X86 1
 #endif
 
-#if defined(__x86_64__) /* gcc */ || \
-    ((defined(_M_X64) || defined(_M_AMD64)) && !defined(_M_ARM64EC)) /* msvc */ || \
-    defined(__x86_64) /* Sun cc */
+#if (defined(__x86_64__) /* gcc */ || \
+     defined(_M_X64) || defined(_M_AMD64) /* msvc */ || \
+     defined(__x86_64) /* Sun cc */) && \
+    !defined(_M_ARM64EC) && !defined(__arm64ec__)
 #define DETECT_ARCH_X86_64 1
 #endif
 
@@ -87,7 +88,7 @@
 #define DETECT_ARCH_ARM 1
 #endif
 
-#if defined(__aarch64__) || defined(_M_ARM64) || defined(_M_ARM64EC)
+#if defined(__aarch64__) || defined(_M_ARM64) || defined(_M_ARM64EC) || defined(__arm64ec__)
 #define DETECT_ARCH_AARCH64 1
 #endif
 
