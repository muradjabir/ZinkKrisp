diff --git a/src/vulkan/wsi/wsi_common_metal_layer.m b/src/vulkan/wsi/wsi_common_metal_layer.m
index 6308d70..9bb11d6 100644
--- a/src/vulkan/wsi/wsi_common_metal_layer.m
+++ b/src/vulkan/wsi/wsi_common_metal_layer.m
@@ -10,12 +10,42 @@
 
 #import <QuartzCore/CAMetalLayer.h>
 #import <Metal/Metal.h>
+#import <Foundation/Foundation.h>
+#include <stdlib.h>
+
+static void
+sync_metal_layer_backing_scale(const CAMetalLayer *metal_layer)
+{
+   const char *sync_env = getenv("KK_SYNC_BACKING_SCALE");
+   if (sync_env && sync_env[0] == '0')
+      return;
+
+   @try {
+      id delegate = metal_layer.delegate;
+      if (!delegate && metal_layer.superlayer)
+         delegate = metal_layer.superlayer.delegate;
+
+      if (delegate && [delegate respondsToSelector:@selector(window)]) {
+         id win = [delegate valueForKey:@"window"];
+         if (win && [win respondsToSelector:@selector(backingScaleFactor)]) {
+            NSNumber *scaleNum = [win valueForKey:@"backingScaleFactor"];
+            CGFloat backingScale = [scaleNum doubleValue];
+            if (backingScale > 0.0 && metal_layer.contentsScale != backingScale) {
+               ((CAMetalLayer *)metal_layer).contentsScale = backingScale;
+            }
+         }
+      }
+   } @catch (NSException *ignored) {
+   }
+}
 
 void
 wsi_metal_layer_size(const CAMetalLayer *metal_layer,
    uint32_t *width, uint32_t *height)
 {
    @autoreleasepool {
+      sync_metal_layer_backing_scale(metal_layer);
+
       /* The reason why "drawableSize" is not being used here because it will
        * only return non-zero values if there has actually been any kind of
        * drawable allocated (acquired). Without this we also run into crashes
@@ -163,6 +193,8 @@
       if (metal_layer.device == nil)
          metal_layer.device = metal_layer.preferredDevice;
 
+      sync_metal_layer_backing_scale(metal_layer);
+
       /* So acquire timeout works */
       metal_layer.allowsNextDrawableTimeout = YES;
       metal_layer.framebufferOnly = framebuffer_only;
